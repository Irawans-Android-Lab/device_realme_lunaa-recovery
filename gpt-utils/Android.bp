cc_library {
    name: "libgptutils.lunaa",
    export_include_dirs: ["."],
    recovery_available: true,
    shared_libs: [
        "libcutils",
        "liblog",
        "libz",
    ],
    srcs: [
        "gpt-utils.cpp",
        "recovery-ufs-bsg.cpp",
    ],
    vendor: true,
    cflags: ["-D_BSG_FRAMEWORK_KERNEL_HEADERS"],
}
